/**
 * @brief  The application entry point.
 * @retval int
 */
int main(void)
{
    /* USER CODE BEGIN 1 */

    /* USER CODE END 1 */

    /* MCU Configuration--------------------------------------------------------*/

    /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
    HAL_Init();

    /* USER CODE BEGIN Init */

    /* USER CODE END Init */

    /* Configure the system clock */
    SystemClock_Config();

    /* USER CODE BEGIN SysInit */

    /* USER CODE END SysInit */

    /* Initialize all configured peripherals */
    MX_GPIO_Init();
    MX_USART1_UART_Init();
    MX_CAN_Init();
    MX_USART2_UART_Init();
    /* USER CODE BEGIN 2 */
    printf("                    FastBoot\r\n");
    printf("----------------------------------------------------------------\r\n");
    printf("version:%02d.%02d.%02d\r\n", BOOT_VERSION_MAJOR, BOOT_VERSION_MINOR, BOOT_VERSION_PATCH);
    printf("flash cfg size:%d\r\n", sizeof(inter_flash_cfg_param_typeDef));
    printf("----------------------------------------------------------------\r\n");

    inter_flash_cfg_init(); // 内部flash 参数区参数校验

    // 读取升级标志
    int8_t ret = inter_flash_cfg_get_app_update_flag();
//	int8_t ret = 0;
    if (ret == 1) // 需要升级
    {
        ymodule_run_flag = 1;
    }
    else if (ret == 0) // 不需要升级
    {
        printf("[BOOT]--->jump app\r\n\r\n");
        boot_check_stack2jump_app(INTER_FLASH_APP_ADDR); // 执行APP程序跳转
        ymodule_run_flag = 0;
    }

    /* USER CODE END 2 */

    /* Infinite loop */
    /* USER CODE BEGIN WHILE */
    while (1)
    {
        if (ymodule_run_flag == 1)
        {
            printf("Ymodule&TPClient is run,waiting for upgrade...\r\n");
            // Ymodem 串口协议测试
            extern uint8_t aFileName[FILE_NAME_LENGTH];

            uint8_t number[11] = {0};
            uint32_t size = 0;
            COM_StatusTypeDef result;
            result = Ymodem_Receive(&size);
            if (result == COM_OK)
            {
                printf((uint8_t *)"\n\n\r Programming Completed Successfully!\n\r--------------------------------\r\n Name: %s", aFileName);

                Int2Str(number, size);
                printf("Size: %dBytes", number);

                inter_flash_cfg_set_app_update_flag(0); // 升级完成后，清除升级标志
                printf("--->jump app\r\n");
                boot_check_stack2jump_app(INTER_FLASH_APP_ADDR); // 执行APP程序跳转
            }
            else
            {
                printf("=---<ret:%d\r\n", result);
            }
        }
        else
        {
            HAL_Delay(1000);
            printf("system error\r\n");
            printf("reboot...\r\n");
            HAL_Delay(2000);

            // 重启
            NVIC_SystemReset();
        }
        /* USER CODE END WHILE */

        /* USER CODE BEGIN 3 */
    }
    /* USER CODE END 3 */
}

